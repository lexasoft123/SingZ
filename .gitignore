node_modules/
out/
dist/
vendor
.engines-src/
*.log
.DS_Store

# fastlane's iOS build output (mobile/ios/fastlane's gym output_directory) —
# a signed .ipa and its .app.dSYM, hundreds of MB, rebuilt per run
build-ios/

# Apple credentials kept beside the checkout for convenience — the App Store
# Connect API key (.p8), signing certificates, provisioning profiles. This
# repo is PUBLIC and the .p8 downloads exactly once from Apple, so a leak is
# both immediate and unrecoverable. Belt and braces: the directory, and the
# extensions wherever they land.
.keys/
*.p8
*.p12
*.mobileprovision

# session worktrees are never repo content
.claude/worktrees/

# beat-detector eval harness: downloaded datasets and run results stay local
eval/beats/data
eval/beats/out/
# and the same path as a SYMLINK: a worktree links the cache from the main
# checkout rather than re-deriving gigabytes of mixes, and `foo/` with the
# trailing slash matches directories only — git sees a symlink as a file, so
# without this line the link shows up as untracked and is one `git add -A`
# away from being committed. `vendor` above is already slash-less for the
# same reason; this is the entry that was missed.
eval/beats/out

# OAuth client modules — generated by the apply-gdrive-config scripts from
# gitignored mobile/gdrive.config.json (EMPTY without it); never tracked
src/main/gdrive-config.ts
mobile/src/gdrive-config.ts

# phone analysis bundle — generated by mobile/scripts/build-analysis.mjs from
# the desktop analysis sources (postinstall); never tracked
mobile/src/gen/

# SingzCore pod's copy of the shared C++ core — materialized from
# mobile/native/core by mobile/scripts/sync-singzcore.js (postinstall);
# CocoaPods cannot glob outside the pod dir, so the copy exists only locally
mobile/ios/SingzCore/core/
# …and the vendored libFLAC, synced beside it by the same script
mobile/ios/SingzCore/flac/

# local-only tooling state: the logged-in Ultimate Guitar browser profile the
# score-scout agent drives (contains a live session cookie — never commit it)
.local/
