{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host native debug",
      "binaryDir": "${sourceDir}/build/native/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host native release",
      "binaryDir": "${sourceDir}/build/native/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-release-strict",
      "displayName": "zdsp strict Release graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-release-strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-asan-ubsan",
      "displayName": "zdsp ASan and UBSan graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-tsan",
      "displayName": "zdsp TSan graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "zdsp-release-strict",
      "configurePreset": "zdsp-release-strict",
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests", "audio_monitor_session_tests", "native_audio_ownership_tests", "native_playback_session_tests"]
    },
    {
      "name": "zdsp-asan-ubsan",
      "configurePreset": "zdsp-asan-ubsan",
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests", "audio_monitor_session_tests", "native_audio_ownership_tests", "native_playback_session_tests"]
    },
    {
      "name": "zdsp-tsan",
      "configurePreset": "zdsp-tsan",
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests", "audio_monitor_session_tests", "native_audio_ownership_tests", "native_playback_session_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-release-strict",
      "configurePreset": "zdsp-release-strict",
      "filter": { "include": { "name": "^(zdsp_(graph_tests|analysis_tests|realtime_source_policy)|prepared_audio_tests|audio_monitor_session_tests|native_(audio_ownership|playback_(session|stale_retirement_failure|provider_dispose_failure))_tests|monitor_realtime_source_policy|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-asan-ubsan",
      "configurePreset": "zdsp-asan-ubsan",
      "filter": { "include": { "name": "^(zdsp_(graph_tests|analysis_tests)|prepared_audio_tests|audio_monitor_session_tests|native_(audio_ownership|playback_(session|stale_retirement_failure|provider_dispose_failure))_tests|monitor_realtime_source_policy|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-tsan",
      "configurePreset": "zdsp-tsan",
      "filter": { "include": { "name": "^(zdsp_(graph_tests|analysis_tests)|prepared_audio_tests|audio_monitor_session_tests|native_(audio_ownership|playback_(session|stale_retirement_failure|provider_dispose_failure))_tests|monitor_realtime_source_policy|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    }
  ]
}
