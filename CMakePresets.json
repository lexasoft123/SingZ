{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-alsa",
      "inherits": "host-release",
      "displayName": "Linux ALSA with Clang 21",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/build/native/linux-alsa",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-21",
        "CMAKE_CXX_COMPILER": "clang++-21"
      }
    },
    {
      "name": "host-debug",
      "displayName": "Host native debug",
      "binaryDir": "${sourceDir}/build/native/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host native release",
      "binaryDir": "${sourceDir}/build/native/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-release-strict",
      "displayName": "zdsp strict Release graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-release-strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Werror",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-asan-ubsan",
      "displayName": "zdsp ASan and UBSan graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "zdsp-tsan",
      "displayName": "zdsp TSan graph gate",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "binaryDir": "${sourceDir}/build/native/zdsp-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "monitor-spike",
      "inherits": "zdsp-release-strict",
      "binaryDir": "${sourceDir}/build/native/monitor-spike",
      "cacheVariables": {
        "SINGZ_MONITOR_SPIKE": "ON",
        "SINGZ_CORE_TESTS": "OFF",
        "SINGZ_BUILD_HOST_TOOLS": "OFF"
      }
    },
    {
      "name": "monitor-spike-asan",
      "inherits": "zdsp-asan-ubsan",
      "binaryDir": "${sourceDir}/build/native/monitor-spike-asan",
      "cacheVariables": {
        "SINGZ_MONITOR_SPIKE": "ON",
        "SINGZ_CORE_TESTS": "OFF",
        "SINGZ_BUILD_HOST_TOOLS": "OFF"
      }
    },
    {
      "name": "monitor-spike-tsan",
      "inherits": "zdsp-tsan",
      "binaryDir": "${sourceDir}/build/native/monitor-spike-tsan",
      "cacheVariables": {
        "SINGZ_MONITOR_SPIKE": "ON",
        "SINGZ_CORE_TESTS": "OFF",
        "SINGZ_BUILD_HOST_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-alsa",
      "configurePreset": "linux-alsa",
      "jobs": 4,
      "targets": ["audio_host_linux_tests", "shared_audio_service_tests", "singz-audio-host"]
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "jobs": 4
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "jobs": 4
    },
    {
      "name": "zdsp-release-strict",
      "configurePreset": "zdsp-release-strict",
      "jobs": 4,
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests",
        "mp3_decoder_tests", "streaming_lane_feeder_tests", "lane_measure_tests", "native_audio_ownership_tests", "audio_input_latency_tests", "native_playback_session_tests", "native_playback_contract_tests",
        "voice_monitor_tests", "singz_check_voice_monitor_realtime",
        "playback_presentation_history_tests", "record_placement_tests", "take_conform_tests", "take_conform_negative_ratio", "take_conform_negative_placement", "take_conform_negative_latency", "take_conform_negative_drift"]
    },
    {
      "name": "zdsp-asan-ubsan",
      "configurePreset": "zdsp-asan-ubsan",
      "jobs": 4,
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests",
        "mp3_decoder_tests", "streaming_lane_feeder_tests", "lane_measure_tests", "native_audio_ownership_tests", "audio_input_latency_tests", "native_playback_session_tests", "native_playback_contract_tests",
        "voice_monitor_tests", "singz_check_voice_monitor_realtime",
        "playback_presentation_history_tests", "record_placement_tests", "take_conform_tests", "take_conform_negative_ratio", "take_conform_negative_placement", "take_conform_negative_latency", "take_conform_negative_drift"]
    },
    {
      "name": "zdsp-tsan",
      "configurePreset": "zdsp-tsan",
      "jobs": 4,
      "targets": ["zdsp_graph_tests", "zdsp_analysis_tests", "prepared_audio_tests",
        "mp3_decoder_tests", "streaming_lane_feeder_tests", "lane_measure_tests", "native_audio_ownership_tests", "audio_input_latency_tests", "native_playback_session_tests", "native_playback_contract_tests",
        "voice_monitor_tests", "singz_check_voice_monitor_realtime",
        "playback_presentation_history_tests", "record_placement_tests", "take_conform_tests", "take_conform_negative_ratio", "take_conform_negative_placement", "take_conform_negative_latency", "take_conform_negative_drift"]
    },
    {
      "name": "monitor-spike",
      "configurePreset": "monitor-spike",
      "jobs": 4,
      "targets": [
        "monitor_spike_harness",
        "monitor_spike_tests",
        "monitor_spike_policy"
      ]
    },
    {
      "name": "monitor-spike-asan",
      "configurePreset": "monitor-spike-asan",
      "jobs": 4,
      "targets": [
        "monitor_spike_harness",
        "monitor_spike_tests",
        "monitor_spike_policy"
      ]
    },
    {
      "name": "monitor-spike-tsan",
      "configurePreset": "monitor-spike-tsan",
      "jobs": 4,
      "targets": [
        "monitor_spike_harness",
        "monitor_spike_tests",
        "monitor_spike_policy"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-alsa",
      "configurePreset": "linux-alsa",
      "filter": { "include": { "name": "^(audio_host_linux_tests|shared_audio_service_tests)$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-release-strict",
      "configurePreset": "zdsp-release-strict",
      "filter": { "include": { "name": "^(take_conform_.*|native_playback_mono_.*|playback_presentation_history_tests|record_placement_tests|voice_monitor_.*|zdsp_(graph_tests|analysis_tests|realtime_source_policy)|prepared_audio_tests|mp3_decoder_tests|streaming_lane_feeder_tests|lane_measure_tests|audio_input_latency_tests|native_(audio_ownership|playback_(session|contract|stale_retirement_failure|provider_dispose_failure))_tests|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-asan-ubsan",
      "configurePreset": "zdsp-asan-ubsan",
      "filter": { "include": { "name": "^(take_conform_.*|native_playback_mono_.*|playback_presentation_history_tests|record_placement_tests|voice_monitor_.*|zdsp_(graph_tests|analysis_tests)|prepared_audio_tests|mp3_decoder_tests|streaming_lane_feeder_tests|lane_measure_tests|audio_input_latency_tests|native_(audio_ownership|playback_(session|contract|stale_retirement_failure|provider_dispose_failure))_tests|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "zdsp-tsan",
      "configurePreset": "zdsp-tsan",
      "filter": { "include": { "name": "^(take_conform_.*|native_playback_mono_.*|playback_presentation_history_tests|record_placement_tests|voice_monitor_.*|zdsp_(graph_tests|analysis_tests)|prepared_audio_tests|mp3_decoder_tests|streaming_lane_feeder_tests|lane_measure_tests|audio_input_latency_tests|native_(audio_ownership|playback_(session|contract|stale_retirement_failure|provider_dispose_failure))_tests|playback_realtime_(source_policy|policy_negative))$" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "monitor-spike",
      "configurePreset": "monitor-spike",
      "filter": {
        "include": {
          "name": "^monitor_spike_"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "monitor-spike-asan",
      "configurePreset": "monitor-spike-asan",
      "filter": {
        "include": {
          "name": "^monitor_spike_"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "monitor-spike-tsan",
      "configurePreset": "monitor-spike-tsan",
      "filter": {
        "include": {
          "name": "^monitor_spike_"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
