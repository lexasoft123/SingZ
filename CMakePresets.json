{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host native debug",
      "binaryDir": "${sourceDir}/build/native/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host native release",
      "binaryDir": "${sourceDir}/build/native/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SINGZ_BUILD_HOST_TOOLS": "ON",
        "SINGZ_CORE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
