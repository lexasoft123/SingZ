[
  {
    "name": "a new project uploads everything and creates no ids",
    "local": {
      "dir": "Song",
      "top": [
        {
          "name": "project.json",
          "md5": "p1",
          "size": 100,
          "path": "/library/Song/project.json",
          "mime": "application/json"
        },
        {
          "name": "lyrics.json",
          "md5": "l1",
          "size": 100,
          "path": "/library/Song/lyrics.json",
          "mime": "application/json"
        }
      ],
      "stems": [
        {
          "name": "vocals.wav",
          "md5": "v1",
          "size": 5000,
          "path": "/library/Song/stems/vocals.wav",
          "mime": "audio/wav"
        },
        {
          "name": "drums.wav",
          "md5": "d1",
          "size": 5000,
          "path": "/library/Song/stems/drums.wav",
          "mime": "audio/wav"
        }
      ]
    },
    "remote": {
      "top": [],
      "stems": []
    },
    "expected": {
      "dir": "Song",
      "upload": [
        {
          "name": "project.json",
          "where": "top",
          "path": "/library/Song/project.json",
          "mime": "application/json"
        },
        {
          "name": "lyrics.json",
          "where": "top",
          "path": "/library/Song/lyrics.json",
          "mime": "application/json"
        },
        {
          "name": "vocals.wav",
          "where": "stems",
          "path": "/library/Song/stems/vocals.wav",
          "mime": "audio/wav"
        },
        {
          "name": "drums.wav",
          "where": "stems",
          "path": "/library/Song/stems/drums.wav",
          "mime": "audio/wav"
        }
      ],
      "unchanged": 0,
      "trash": [],
      "rows": [
        {
          "name": "project.json",
          "size": "100",
          "md5Checksum": "p1"
        },
        {
          "name": "lyrics.json",
          "size": "100",
          "md5Checksum": "l1"
        }
      ]
    }
  },
  {
    "name": "a clean project uploads nothing and counts every file unchanged",
    "local": {
      "dir": "Song",
      "top": [
        {
          "name": "project.json",
          "md5": "p1",
          "size": 100,
          "path": "/library/Song/project.json",
          "mime": "application/json"
        },
        {
          "name": "lyrics.json",
          "md5": "l1",
          "size": 100,
          "path": "/library/Song/lyrics.json",
          "mime": "application/json"
        }
      ],
      "stems": [
        {
          "name": "vocals.wav",
          "md5": "v1",
          "size": 5000,
          "path": "/library/Song/stems/vocals.wav",
          "mime": "audio/wav"
        }
      ]
    },
    "remote": {
      "folderId": "folder-id",
      "stemsId": "stems-id",
      "top": [
        {
          "id": "r1",
          "name": "project.json",
          "md5Checksum": "p1"
        },
        {
          "id": "r2",
          "name": "lyrics.json",
          "md5Checksum": "l1"
        },
        {
          "id": "stems-id",
          "name": "stems",
          "mimeType": "application/vnd.google-apps.folder"
        }
      ],
      "stems": [
        {
          "id": "r3",
          "name": "vocals.wav",
          "md5Checksum": "v1"
        }
      ]
    },
    "expected": {
      "dir": "Song",
      "upload": [],
      "unchanged": 3,
      "trash": [],
      "rows": [
        {
          "name": "project.json",
          "size": "100",
          "md5Checksum": "p1",
          "id": "r1"
        },
        {
          "name": "lyrics.json",
          "size": "100",
          "md5Checksum": "l1",
          "id": "r2"
        }
      ]
    }
  },
