# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
# The Play upload key and its passwords. Under Play App Signing a lost upload
# key is recoverable (Google resets it on request) — a leaked one is not, so
# these live in a password manager, never here.
*.jks
keystore.properties
.kotlin/

# Play publishing. The service-account JSON grants upload rights to the whole
# listing — it belongs in a password manager and a CI secret, nowhere else.
android/fastlane/play-service-account.json
# supply's image tree is staged from docs/play-assets at run time, so the same
# PNGs are never committed twice
android/fastlane/metadata/android/en-US/images/
android/fastlane/report.xml
android/fastlane/Preview.html

# The App Review contact block is a REAL PERSON's name, phone and email.
# This repo is public, and a phone number in a public history is permanent —
# removing it later takes a history rewrite. The values live in the SOPS
# store (.keys/secrets.enc.yaml) and are passed to deliver at run time.
# notes.txt stays tracked: it is app prose with nothing personal in it.
ios/fastlane/metadata/review_information/first_name.txt
ios/fastlane/metadata/review_information/last_name.txt
ios/fastlane/metadata/review_information/phone_number.txt
ios/fastlane/metadata/review_information/email_address.txt

# App Store publishing. The distribution cert, the provisioning profile and
# the App Store Connect API key all grant upload/release rights — same rule
# as the Play service account: a password manager and a CI secret, never here.
*.p12
*.p8
*.mobileprovision
ios/fastlane/app-store-connect-api-key.json
ios/fastlane/report.xml
ios/fastlane/Preview.html

# node.js
#
node_modules/

# Bundled sample project ("Sing with me") — an original composition
# synthesized deterministically by scripts/make-sample.js (postinstall);
# nothing copyrighted ships in the repo or the app bundle.
assets/sample/
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

