# Play uploads.
#
# The FIRST bundle for a package must go up through the Play Console by hand:
# the Developer API cannot create an app entry, and refuses a package it has
# never seen. Everything after that lands here.
#
# Store listing text and graphics are NOT pushed by the release lanes. A
# release should ship a binary, not silently rewrite the shopfront — run the
# `metadata` lane deliberately when the listing is what changed.

default_platform(:android)

ANDROID_DIR = File.expand_path("..", __dir__)
REPO_ROOT   = File.expand_path("../../..", __dir__)
AAB_PATH    = File.join(ANDROID_DIR, "app/build/outputs/bundle/release/app-release.aab")
ASSETS_DIR  = File.join(REPO_ROOT, "docs/play-assets")
LOCALE_DIR  = File.join(__dir__, "metadata/android/en-US")

# Play truncates silently; better to know at build time than to discover a
# half-sentence on the store page.
CHANGELOG_LIMIT = 500

# The same fold gradle applies, so a lane can name the changelog file that
# matches the bundle it is about to upload: 0.14.0 -> 1400.
def singz_version
  pkg = JSON.parse(File.read(File.join(REPO_ROOT, "package.json")))
  name = pkg["version"]
  major, minor, patch = name.split(".").map(&:to_i)
  code = ENV["SINGZ_VERSION_CODE"]&.to_i || (major * 10_000 + minor * 100 + patch)
  [name, code]
end

# The closed track's name is decided HERE and nowhere else. v0.15.0 shipped
# into "alpha" because the workflow carried a second default of its own and the
# two disagreed — the caller passes PLAY_CLOSED_TRACK through or passes nothing.
# ENV.fetch is not enough on its own: CI sets the variable to the empty string
# when the repo has no value for it, and an empty track name reaches Play as a
# track that cannot exist.
def closed_track
  name = ENV["PLAY_CLOSED_TRACK"].to_s.strip
  name.empty? ? "Testing" : name
end

platform :android do
  # Against the track a tag really uses, not a spare one: the track name is
  # itself something that can be wrong, and a rehearsal on "internal" would
  # have waved v0.15.0's "alpha" straight through.
  desc "Check the service account, the bundle and the track without shipping anything"
  lane :validate do
    play_publish(track: closed_track, validate_only: true)
  end

  desc "Upload to the internal track"
  lane :internal do
    play_publish(track: "internal")
  end

  # The closed track is a CUSTOM one called "Testing", not Play's stock
  # "alpha" — a custom track's API name is whatever it was named in the
  # console, and asking for the wrong one returns an empty track rather than
  # an error, which looks exactly like a release that failed to upload.
  desc "Upload to the closed testing track (PLAY_CLOSED_TRACK, default 'Testing')"
  lane :closed do
    play_publish(track: closed_track)
  end

  desc "Upload to production as a staged rollout (PLAY_ROLLOUT, default 10%)"
  lane :production do
    play_publish(
      track: "production",
      rollout: ENV.fetch("PLAY_ROLLOUT", "0.1")
    )
  end

  # Play refuses a FINISHED release while a declaration the bundle needs is
  # unanswered — and the declaration form only appears in the console once Play
  # HAS the bundle. v0.22.0 met that circle: it added
  # FOREGROUND_SERVICE_MEDIA_PLAYBACK, and `closed` died on "You must let us
  # know whether your app uses any Foreground Service permissions", thrown by
  # edits.commit, so the upload was rolled back whole and the form stayed
  # locked. Every workaround written down on the web is "upload it by hand in
  # the console"; measured 2026-09-16, a DRAFT release passes that same commit.
  # It reaches no tester — it only puts the bundle where the console can see
  # it. Fill the declaration, then `promote`.
  desc "Upload as a DRAFT release on the closed track — reaches nobody, unlocks console declarations"
  lane :draft do
    play_publish(track: closed_track, release_status: "draft")
  end

  desc "Finish a draft already on the closed track — no rebuild, no re-upload"
  lane :promote do
    complete_draft(track: closed_track)
  end

  desc "Show exactly what the metadata lane would push — stages files, no network"
  lane :preview do
    stage_images
    name, code = singz_version
    UI.message("SingZ #{name} (versionCode #{code})")
    { "title.txt" => 30, "short_description.txt" => 80, "full_description.txt" => 4000 }
      .each do |file, limit|
        len = File.read(File.join(LOCALE_DIR, file)).strip.length
        UI.message(format("  %-22s %5d / %d%s", file, len, limit, len > limit ? "  OVER" : ""))
      end
    log = File.join(LOCALE_DIR, "changelogs", "#{code}.txt")
    if File.exist?(log)
      len = File.read(log).strip.length
      UI.message(format("  %-22s %5d / %d%s", "changelogs/#{code}.txt", len,
                        CHANGELOG_LIMIT, len > CHANGELOG_LIMIT ? "  OVER" : ""))
    else
      UI.important("  no changelog for versionCode #{code}")
    end
    UI.success("Staged. Nothing was uploaded.")
  end

  desc "Push store listing text and graphics only — no binary"
  lane :metadata do
    stage_images
    _name, code = singz_version
    # With no binary in the edit, supply still wants a release to anchor to,
    # and fails with "Could not find release for version code ''" even when
    # changelogs are skipped. Naming the track and the code it already holds
    # satisfies it without shipping anything.
    upload_to_play_store(
      track: closed_track,
      version_code: code,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true
    )
    UI.success("Listing pushed. The binary tracks were not touched.")
  end
end

# --- helpers ---------------------------------------------------------------

# Graphics live in docs/play-assets (one source of truth, regenerated by
# scripts/make-play-assets.sh). supply wants its own tree, so build that tree
# at run time rather than committing the same PNGs twice.
private_lane :stage_images do
  images = File.join(LOCALE_DIR, "images")
  shots  = File.join(images, "phoneScreenshots")
  FileUtils.rm_rf(images)
  FileUtils.mkdir_p(shots)

  FileUtils.cp(File.join(ASSETS_DIR, "icon-512.png"), File.join(images, "icon.png"))
  FileUtils.cp(File.join(ASSETS_DIR, "feature-1024x500.png"),
               File.join(images, "featureGraphic.png"))

  found = Dir[File.join(ASSETS_DIR, "screenshot-*.png")].sort
  UI.user_error!("No screenshots in #{ASSETS_DIR}") if found.empty?
  UI.important("Play wants at least 2 phone screenshots, found #{found.size}") if found.size < 2
  found.each_with_index do |src, i|
    FileUtils.cp(src, File.join(shots, format("%02d_en-US.png", i + 1)))
  end
  UI.message("Staged #{found.size} screenshots + icon + feature graphic")
end

# supply keys changelogs by versionCode. Reuse the release note that the repo
# already requires before tagging, rather than inventing a second place to
# write one.
# The store text for every language comes out of the release notes, which is
# the one place a release is described. scripts/store-notes.cjs does the
# extracting and the length check; this only refuses to ship without it.
#
# It used to truncate the long notes at 500 characters when a changelog was
# missing, which put half a sentence on the storefront. Uploading a binary
# with no release notes, or with notes nobody wrote, is worse than stopping.
private_lane :sync_changelog do
  name, _code = singz_version
  script = File.join(REPO_ROOT, "scripts/store-notes.cjs")
  UI.user_error!("scripts/store-notes.cjs is missing") unless File.exist?(script)
  Dir.chdir(REPO_ROOT) { sh("node", "scripts/store-notes.cjs") }
  UI.success("Store notes for v#{name} are current")
end

private_lane :play_publish do |options|
  name, code = singz_version
  UI.user_error!("No bundle at #{AAB_PATH} — run `./gradlew bundleRelease` first") \
    unless File.exist?(AAB_PATH)

  sync_changelog
  UI.message("SingZ #{name} (#{code}) -> #{options[:track]}")

  begin
    upload_to_play_store(
      track: options[:track],
      aab: AAB_PATH,
      validate_only: options[:validate_only] || false,
      rollout: options[:rollout],
      release_status: options[:release_status] || (options[:rollout] ? "inProgress" : "completed"),
      skip_upload_apk: true,
      # A binary upload must not rewrite the shopfront — that is the `metadata`
      # lane's job, run on purpose.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  rescue => e
    # Play answers a track nobody ever opened in the console with "Release in
    # track targeting no countries" — which names neither the track nor the
    # cure, and arrives only after the whole bundle has gone up. Say which
    # track, and what to do about it.
    raise unless e.message.include?("targeting no countries")
    UI.user_error!(<<~MSG)
      Play refused the release: the '#{options[:track]}' track targets no countries.

      That is what an untouched track says. A track has to be opened once in the
      Play Console — countries and, for a closed track, its tester list — before
      the API may release into it. No upload can do that part.

      Either open '#{options[:track]}' in the console, or point PLAY_CLOSED_TRACK
      at the track you actually test on. Nothing was published; the version code
      is still free.
    MSG
  end

  if options[:validate_only]
    UI.success("Validated. Credentials and bundle are acceptable; nothing was shipped.")
  elsif options[:release_status] == "draft"
    UI.success(<<~MSG)
      SingZ #{name} (#{code}) is a DRAFT on the #{options[:track]} track — no tester has it.

      The console can see the bundle now, so any declaration it was waiting for
      (App content -> Foreground service permissions, and friends) can be
      answered. Then: fastlane android promote
    MSG
  else
    UI.success("SingZ #{name} (#{code}) is on the #{options[:track]} track.")
  end
end

# The other half of `draft`, and the half supply cannot do: `release_status` is
# only read while supply uploads a BINARY, so asking it to finish an existing
# draft attaches the changelogs and leaves the release a draft — accepted,
# ignored, and silent about it (measured 2026-09-16). The edit below changes
# that one field with the same credentials supply itself uses.
private_lane :complete_draft do |options|
  require "google/apis/androidpublisher_v3"
  require "googleauth"

  _name, code = singz_version
  track_name = options[:track]

  key_data = ENV["SUPPLY_JSON_KEY_DATA"].to_s
  key_file = ENV["SUPPLY_JSON_KEY"] || CredentialsManager::AppfileConfig.try_fetch_value(:json_key_file)
  UI.user_error!("No Play credentials: set SUPPLY_JSON_KEY_DATA, or SUPPLY_JSON_KEY, or put play-service-account.json beside the Appfile") \
    if key_data.empty? && (key_file.nil? || !File.exist?(key_file))
  package = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)

  service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: key_data.empty? ? File.open(key_file) : StringIO.new(key_data),
    scope: ["https://www.googleapis.com/auth/androidpublisher"]
  )

  # LOOK before touching anything. The changelog upload below is a commit of
  # its own against a live release, so "there is no such release" and "that one
  # is not a draft" have to be answered first or they arrive as supply's own
  # error after the notes have already gone up. The probe edit is thrown away:
  # an edit is a snapshot, and supply's commit would make this one stale.
  probe = service.insert_edit(package)
  found = begin
    track = service.get_edit_track(package, probe.id, track_name)
    track.releases.to_a.find { |r| r.version_codes.to_a.map(&:to_s).include?(code.to_s) }
  rescue Google::Apis::Error => e
    # Same lesson as play_publish's "targeting no countries": Play answers a
    # track name it does not know with a bare "Invalid request", naming neither
    # the track nor the cure. This catches the whole error class rather than
    # matching that text, so it must not claim to know WHY Play refused — a 5xx
    # or a rate limit on that read lands here too. (Credentials do not: an
    # account that may not edit at all fails one line up, at insert_edit.)
    # Print Play's own words, then the hint.
    UI.user_error!(<<~MSG)
      Play refused to read the '#{track_name}' track: #{e.message.to_s.lines.first&.strip}

      If that track name is wrong, PLAY_CLOSED_TRACK is where it comes from —
      a custom track's API name is whatever the console called it. Otherwise the
      line above is Play's own reason. Nothing was changed.
    MSG
  ensure
    service.delete_edit(package, probe.id) rescue nil
  end

  UI.user_error!("No release for versionCode #{code} on '#{track_name}' — upload one first (`fastlane android draft`)") unless found
  if found.status == "completed"
    UI.success("versionCode #{code} is already the completed release on '#{track_name}'. Nothing was changed.")
    next
  end
  # inProgress and halted are a rollout's states, and a rollout carries a user
  # fraction that Play refuses alongside "completed". Whatever put the track in
  # that state owns it — say so rather than half-finishing somebody's rollout.
  UI.user_error!("versionCode #{code} is '#{found.status}' on '#{track_name}', not a draft — finish or halt that rollout in the console") \
    unless found.status == "draft"

  # The notes still come from the release notes file, through supply, so this
  # lane invents no second source for them.
  sync_changelog
  upload_to_play_store(
    track: track_name,
    version_code: code,
    skip_upload_aab: true,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: false
  )

  edit = service.insert_edit(package)
  begin
    track = service.get_edit_track(package, edit.id, track_name)
    release = track.releases.to_a.find { |r| r.version_codes.to_a.map(&:to_s).include?(code.to_s) }
    UI.user_error!("versionCode #{code} left '#{track_name}' while this lane ran") unless release

    UI.message("#{track_name}: #{release.name} #{release.status} -> completed")
    release.status = "completed"
    # ONE live release per track: leaving the previous completed release beside
    # this one in the array is refused at commit.
    track.releases = [release]
    service.update_edit_track(package, edit.id, track_name, track)
    service.commit_edit(package, edit.id)
  rescue StandardError
    # An uncommitted edit changes nothing, but leaving it lying around makes
    # the next run's state harder to read.
    service.delete_edit(package, edit.id) rescue nil
    raise
  end

  UI.success("SingZ #{code} is live on the #{track_name} track.")
end
