","s":49.513333333333335,"e":49.763333333333335},{"w":"the","s":49.763333333333335,"e":50.09666666666667},{"w":"mine","s":50.09666666666667,"e":50.513333333333335}]},{"start":46.85,"end":49.85,"text":"I loaded 16 tons of number nine coal","words":[{"w":"I","s":46.85,"e":47.012},{"w":"loaded","s":47.012,"e":47.58},{"w":"16","s":47.58,"e":47.823},{"w":"tons","s":47.823,"e":48.228},{"w":"of","s":48.228,"e":48.472},{"w":"number","s":48.472,"e":49.039},{"w":"nine","s":49.039,"e":49.445},{"w":"coal","s":49.445,"e":49.85}]},{"start":50.04,"end":53.24,"text":"And the straw boss said, \"Well, a-bless my soul\"","words":[{"w":"And","s":50.04,"e":50.301},{"w":"the","s":50.301,"e":50.562},{"w":"straw","s":50.562,"e":50.954},{"w":"boss","s":50.954,"e":51.281},{"w":"said,","s":51.281,"e":51.673},{"w":"\"Well,","s":51.673,"e":52.13},{"w":"a-bless","s":52.13,"e":52.652},{"w":"my","s":52.652,"e":52.848},{"w":"soul\"","s":52.848,"e":53.24}]},{"start":56,"end":58.833333333333336,"text":"You load 16 tons, what do you get?","words":[{"w":"You","s":56,"e":56.324},{"w":"load","s":56.324,"e":56.729},{"w":"16","s":56.729,"e":56.971000000000004},{"w":"tons,","s":56.971000000000004,"e":57.457},{"w":"what","s":57.457,"e":57.862},{"w":"do","s":57.862,"e":58.105000000000004},{"w":"you","s":58.105000000000004,"e":58.429},{"w":"get?","s":58.429,"e":58.833}]},{"start":58,"end":62.56,"text":"Another day older and deeper in debt","words":[{"w":"Another","s":58,"e":59.04},{"w":"day","s":59.04,"e":59.1},{"w":"older","s":59.1,"e":59.64},{"w":"and","s":61,"e":61.31},{"w":"deeper","s":61.31,"e":61.89333333333334},{"w":"in","s":61.89333333333334,"e":62.14333333333334},{"w":"debt","s":62.14333333333334,"e":62.56}]},{"start":61.32333333333333,"end":65.79,"text":"St. Peter, don't you call me 'cause I can't go","words":[{"w":"St.","s":61.32333333333333,"e":61.656666666666666},{"w":"Peter,","s":61.656666666666666,"e":62.24},{"w":"don't","s":62.24,"e":62.74},{"w":"you","s":62.74,"e":63.05},{"w":"call","s":63.05,"e":63.46},{"w":"me","s":63.46,"e":63.66},{"w":"'cause","s":64,"e":64.62},{"w":"I","s":64.62,"e":65.04},{"w":"can't","s":65.04,"e":65.54},{"w":"go","s":65.54,"e":65.79}]},{"start":64.62,"end":71.37,"text":"I owe my soul to the company store","words":[{"w":"I","s":64.62,"e":65.04},{"w":"owe","s":65.04,"e":67.04},{"w":"my","s":67.04,"e":67.2},{"w":"soul","s":67.2,"e":67.99},{"w":"to","s":67.99,"e":68.39},{"w":"the","s":68.39,"e":68.99},{"w":"company","s":68.99,"e":70.38},{"w":"store","s":70.38,"e":71.37}]},{"start":72.55,"end":76.3,"text":"I was born one mornin', it was drizzlin' rain","words":[{"w":"I","s":72.55,"e":72.713},{"w":"was","s":72.713,"e":73.039},{"w":"born","s":73.039,"e":73.447},{"w":"one","s":73.447,"e":73.773},{"w":"mornin',","s":73.773,"e":74.507},{"w":"it","s":74.507,"e":74.751},{"w":"was","s":74.751,"e":75.077},{"w":"drizzlin'","s":75.077,"e":75.892},{"w":"rain","s":75.892,"e":76.3}]},{"start":76.82,"end":80.07,"text":"Fightin' and trouble are my middle name","words":[{"w":"Fightin'","s":76.82,"e":77.551},{"w":"and","s":77.551,"e":77.876},{"w":"trouble","s":77.876,"e":78.526},{"w":"are","s":78.526,"e":78.851},{"w":"my","s":78.851,"e":79.095},{"w":"middle","s":79.095,"e":79.664},{"w":"name","s":79.664,"e":80.07}]},{"start":80.22,"end":83.29,"text":"I was raised in the canebrake by an ol' mama lion","words":[{"w":"I","s":80.22,"e":80.343},{"w":"was","s":80.343,"e":80.588},{"w":"raised","s":80.588,"e":81.018},{"w":"in","s":81.018,"e":81.202},{"w":"the","s":81.202,"e":81.448},{"w":"canebrake","s":81.448,"e":82.062},{"w":"by","s":82.062,"e":82.246},{"w":"an","s":82.246,"e":82.43},{"w":"ol'","s":82.43,"e":82.676},{"w":"mama","s":82.676,"e":82.983},{"w":"lion","s":82.983,"e":83.29}]},{"start":84,"end":87.39,"text":"Can't no high toned woman make me walk the line","words":[{"w":"Can't","s":84,"e":84.42399999999999},{"w":"no","s":84.42399999999999,"e":84.636},{"w":"high","s":84.636,"e":84.98899999999999},{"w":"toned","s":84.98899999999999,"e":85.413},{"w":"w