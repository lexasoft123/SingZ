{"source":"lrclib","credit":"Tennessee Ernie Ford — Sixteen Tons","aligned":true,"lines":[{"start":0,"end":9.583333333333334,"text":"Some people say a man is made outta mud","words":[{"w":"Some","s":0,"e":1.04},{"w":"people","s":1.04,"e":1.98},{"w":"say","s":1.98,"e":2.58},{"w":"a","s":7,"e":7.11},{"w":"man","s":7.11,"e":8.05},{"w":"is","s":8.05,"e":8.28},{"w":"made","s":8.28,"e":8.75},{"w":"outta","s":8.75,"e":9.25},{"w":"mud","s":9.25,"e":9.583333333333334}]},{"start":7,"end":11,"text":"A poor man's made outta muscle and blood","words":[{"w":"A","s":7,"e":7.11},{"w":"poor","s":7.11,"e":7.641818181818182},{"w":"man's","s":7.641818181818182,"e":8.28},{"w":"made","s":8.28,"e":8.75},{"w":"outta","s":8.75,"e":9.33},{"w":"muscle","s":9.33,"e":10.03},{"w":"and","s":10.03,"e":10.51},{"w":"blood","s":10.51,"e":11}]},{"start":11,"end":13.916666666666668,"text":"Muscle and blood and skin and bones","words":[{"w":"Muscle","s":11,"e":11.567},{"w":"and","s":11.567,"e":11.891},{"w":"blood","s":11.891,"e":12.377},{"w":"and","s":12.377,"e":12.701},{"w":"skin","s":12.701,"e":13.106},{"w":"and","s":13.106,"e":13.431000000000001},{"w":"bones","s":13.431000000000001,"e":13.917000000000002}]},{"start":15,"end":18.12,"text":"A mind that's a-weak and a back that's strong","words":[{"w":"A","s":15,"e":15.136},{"w":"mind","s":15.136,"e":15.475000000000001},{"w":"that's","s":15.475000000000001,"e":15.95},{"w":"a-weak","s":15.95,"e":16.424},{"w":"and","s":16.424,"e":16.696},{"w":"a","s":16.696,"e":16.831},{"w":"back","s":16.831,"e":17.17},{"w":"that's","s":17.17,"e":17.645},{"w":"strong","s":17.645,"e":18.12}]},{"start":20.01,"end":22.843333333333334,"text":"You load 16 tons, what do you get?","words":[{"w":"You","s":20.01,"e":20.334},{"w":"load","s":20.334,"e":20.739},{"w":"16","s":20.739,"e":20.981},{"w":"tons,","s":20.981,"e":21.467},{"w":"what","s":21.467,"e":21.872},{"w":"do","s":21.872,"e":22.115},{"w":"you","s":22.115,"e":22.439},{"w":"get?","s":22.439,"e":22.843}]},{"start":22,"end":