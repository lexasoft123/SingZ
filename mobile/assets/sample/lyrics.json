w":"owe","s":65,"e":66.87},{"w":"my","s":66.87,"e":67.04},{"w":"soul","s":67.04,"e":67.46},{"w":"to","s":67.46,"e":67.75},{"w":"the","s":67.75,"e":68.19},{"w":"company","s":68.19,"e":69.22},{"w":"store","s":69.22,"e":70}]},{"start":72.55,"end":76.3,"text":"I was born one mornin', it was drizzlin' rain","words":[{"w":"I","s":72.55,"e":72.713},{"w":"was","s":72.713,"e":73.039},{"w":"born","s":73.039,"e":73.447},{"w":"one","s":73.447,"e":73.773},{"w":"mornin',","s":73.773,"e":74.507},{"w":"it","s":74.507,"e":74.751},{"w":"was","s":74.751,"e":75.077},{"w":"drizzlin'","s":75.077,"e":75.892},{"w":"rain","s":75.892,"e":76.3}]},{"start":76.82,"end":80.07,"text":"Fightin' and trouble are my middle name","words":[{"w":"Fightin'","s":76.82,"e":77.551},{"w":"and","s":77.551,"e":77.876},{"w":"trouble","s":77.876,"e":78.526},{"w":"are","s":78.526,"e":78.851},{"w":"my","s":78.851,"e":79.095},{"w":"middle","s":79.095,"e":79.664},{"w":"name","s":79.664,"e":80.07}]},{"start":80.22,"end":83.29,"text":"I was raised in the canebrake by an ol' mama lion","words":[{"w":"I","s":80.22,"e":80.343},{"w":"was","s":80.343,"e":80.588},{"w":"raised","s":80.588,"e":81.018},{"w":"in","s":81.018,"e":81.202},{"w":"the","s":81.202,"e":81.448},{"w":"canebrake","s":81.448,"e":82.062},{"w":"by","s":82.062,"e":82.246},{"w":"an","s":82.246,"e":82.43},{"w":"ol'","s":82.43,"e":82.676},{"w":"mama","s":82.676,"e":82.983},{"w":"lion","s":82.983,"e":83.29}]},{"start":83.34,"end":86.73,"text":"Can't no high toned woman make me walk the line","words":[{"w":"Can't","s":83.34,"e":83.764},{"w":"no","s":83.764,"e":83.976},{"w":"high","s":83.976,"e":84.329},{"w":"toned","s":84.329,"e":84.753},{"w":"woman","s":84.753,"e":85.176},{"w":"make","s":85.176,"e":85.529},{"w":"me","s":85.529,"e":85.741},{"w":"walk","s":85.741,"e":86.094},{"w":"the","s":86.094,"e":86.377},{"w":"line","s":86.377,"e":86.73}]},{"start":86.78,"end":89.61333333333333,"text":"You load 16 tons, what do you get?","words":[{"w":"You","s":86.78,"e":87.104},{"w":"load","s":87.104,"e":87.509},{"w":"16","s":87.509,"e":87.751},{"w":"tons,","s":87.751,"e":88.237},{"w":"what","s":88.237,"e":88.642},{"w":"do","s":88.642,"e":88.885},{"w":"you","s":88.885,"e":89.209},{"w":"get?","s":89.209,"e":89.613}]},{"start":90.14,"end":93.14,"text":"Another day older and deeper in debt","words":[{"w":"Another","s":90.14,"e":90.789},{"w":"day","s":90.789,"e":91.113},{"w":"older","s":91.113,"e":91.599},{"w":"and","s":91.599,"e":91.924},{"w":"deeper","s":91.924,"e":92.491},{"w":"in","s":92.491,"e":92.735},{"w":"debt","s":92.735,"e":93.14}]},{"start":97.02333333333334,"end":100.72,"text":"St. Peter, don't you call me 'cause I can't go","words":[{"w":"St.","s":97.02333333333334,"e":97.35666666666667},{"w":"Peter,","s":97.35666666666667,"e":97.94},{"w":"don't","s":97.94,"e":98.3},{"w":"you","s":98.3,"e":98.52},{"w":"call","s":98.52,"e":98.81},{"w":"me","s":98.81,"e":99},{"w":"'cause","s":99,"e":99.74},{"w":"I","s":99.74,"e":99.86},{"w":"can't","s":99.86,"e":100.47},{"w":"go","s":100.47,"e":100.72}]},{"start":99.74,"end":107,"text":"I owe my soul to the company store","words":[{"w":"I","s":99.74,"e":99.86},{"w":"owe","s":99.86,"e":102.39},{"w":"my","s":102.39,"e":102.79},{"w":"soul","s":102.79,"e":103.58},{"w":"to","s":103.58,"e":103.98},{"w":"the","s":103.98,"e":104.58},{"w":"company","s":104.58,"e":105.97},{"w":"store","s":105.97,"e":107}]},{"start":106.34,"end":109.59,"text":"If you see me comin', better step aside","words":[{"w":"If","s":106.34,"e":106.584},{"w":"you","s":106.584,"e":106.909},{"w":"see","s":106.909,"e":107.234},{"w":"me","s":107.234,"e":107.478},{"w":"comin',","s":107.478,"e":108.128},{"w":"better","s":108.128,"e":108.696},{"w":"step","s":108.696,"e":109.103},{"w":"aside","s":109.103,"e":109.59}]},{"start":111.59,"end":114.59,"text":"A lotta men didn't, a lotta men died","words":[{"w":"A","s":111.59,"e":111.752},{"w":"lotta","s":111.752,"e":112.239},{"w":"men","s":112.239,"e":112.563},{"w":"didn't,","s":112.563,"e":113.212},{"w":"a","s":113.212,"e":113.374},{"w":"lotta","s":113.374,"e":113.86},{"w":"men","s":113.86,"e":114.185},{"w":"died","s":114.185,"e":114.59}]},{"start":115.29,"end":118.10000000000001,"text":"One fist of iron, the other of steel","words":[{"w":"One","s":115.29,"e":115.594},{"w":"fist","s":115.594,"e":115.974},{"w":"of","s":115.974,"e":116.201},{"w":"iron,","s":116.201,"e":116.657},{"w":"the","s":116.657,"e":116.961},{"w":"other","s":116.961,"e":117.416},{"w":"of","s":117.416,"e":117.644},{"w":"steel","s":117.644,"e":118.1}]},{"start":118.15,"end":119.79,"text":"If the right one don't get you","words":[{"w":"If","s":118.15,"e":118.309},{"w":"the","s":118.309,"e":118.52},{"w":"right","s":118.52,"e":118.838},{"w":"one","s":118.838,"e":119.049},{"w":"don't","s":119.049,"e":119.367},{"w":"get","s":119.367,"e":119.578},{"w":"you","s":119.578,"e":119.79}]},{"start":119.84,"end":121.46000000000001,"text":"Then the left one will","words":[{"w":"Then","s":119.84,"e":120.192},{"w":"the","s":120.192,"e":120.474},{"w":"left","s":120.474,"e":120.826},{"w":"one","s":120.826,"e":121.108},{"w":"will","s":121.108,"e":121.46}]},{"start":121.51,"end":124.34333333333333,"text":"You load 16 tons, what do you get?","words":[{"w":"You","s":121.51,"e":121.834},{"w":"load","s":121.834,"e":122.239},{"w":"16","s":122.239,"e":122.481},{"w":"tons,","s":122.481,"e":122.967},{"w":"what","s":122.967,"e":123.372},{"w":"do","s":123.372,"e":123.615},{"w":"you","s":123.615,"e":123.939},{"w":"get?","s":123.939,"e":124.343}]},{"start":124.53,"end":127.53,"text":"Another day older and deeper in debt","words":[{"w":"Another","s":124.53,"e":125.179},{"w":"day","s":125.179,"e":125.503},{"w":"older","s":125.503,"e":125.989},{"w":"and","s":125.989,"e":126.314},{"w":"deeper","s":126.314,"e":126.881},{"w":"in","s":126.881,"e":127.125},{"w":"debt","s":127.125,"e":127.53}]},{"start":127.76,"end":131.59333333333333,"text":"St. Peter, don't you call me 'cause I can't go","words":[{"w":"St.","s":127.76,"e":128.086},{"w":"Peter,","s":128.086,"e":128.657},{"w":"don't","s":128.657,"e":129.147},{"w":"you","s":129.147,"e":129.473},{"w":"call","s":129.473,"e":129.881},{"w":"me","s":129.881,"e":130.125},{"w":"'cause","s":130.125,"e":130.696},{"w":"I","s":130.696,"e":130.859},{"w":"can't","s":130.859,"e":131.349},{"w":"go","s":131.349,"e":131.593}]},{"start":132.95,"end":135.78333333333333,"text":"I owe my soul to the company store","words":[{"w":"I","s":132.95,"e":133.112},{"w":"owe","s":133.112,"e":133.436},{"w":"my","s":133.436,"e":133.679},{"w":"soul","s":133.679,"e":134.083},{"w":"to","s":134.083,"e":134.326},{"w":"the","s":134.326,"e":134.65},{"w":"company","s":134.65,"e":135.298},{"w":"store","s":135.298,"e":135.783}]}]}