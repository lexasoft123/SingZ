{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // node: the jest suites reach for the shared test harness in ../tests/shared,
    // which is node-side (fs, crypto) by nature — the app code never is
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
