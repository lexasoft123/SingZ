+fn css_emoji_advance(font: &CTFont, glyph: CGGlyph, logical_size: f32) -> Option<f64> {
+    let hhea = font.get_font_table(u32::from_be_bytes(*b"hhea"))?;
+    let hmtx = font.get_font_table(u32::from_be_bytes(*b"hmtx"))?;
+    let head = font.get_font_table(u32::from_be_bytes(*b"head"))?;
+    let read_u16 = |data: &[u8], offset: usize| -> Option<u16> {
+        Some(u16::from_be_bytes(
+            data.get(offset..offset + 2)?.try_into().ok()?,
+        ))
+    };
+    let count = read_u16(hhea.bytes(), 34)? as usize;
+    let units = read_u16(head.bytes(), 18)?;
+    if count == 0 || units == 0 {
