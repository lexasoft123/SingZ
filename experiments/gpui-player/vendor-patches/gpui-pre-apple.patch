+impl MetalRenderer {
+    /// Select a cached UI target only while a host enables grain or a backdrop.
+    /// Every frame then remains entirely on the GPU, including screenshot frames.
+    fn prepare_grain(
+        &mut self,
+        viewport: Size<DevicePixels>,
+    ) -> Result<Option<Retained<ProtocolObject<dyn MTLTexture>>>> {
+        let backdrop = crate::grain_effect::backdrop();
+        let configured_grain = crate::grain_effect::current().filter(|c| c.opacity > 0.);
+        if configured_grain.is_none() && backdrop.is_none() {
+            self.grain = None;
+            return Ok(None);
+        }
+        if let Some(background) = &backdrop {
+            anyhow::ensure!(
+                background.width == viewport.width.0 as u32
+                    && background.height == viewport.height.0 as u32,
+                "scene backdrop must match the physical viewport"
+            );
+        }
+        let config = configured_grain.unwrap_or_else(|| crate::grain_effect::GrainEffect {
+            version: 0,
+            pixels: vec![0, 0, 0, 0].into(),
+            width: 1,
+            height: 1,
+            opacity: 0.,
+        });
+        let backdrop_version = backdrop.as_ref().map(|b| b.version);
+        anyhow::ensure!(
+            viewport.width.0 > 0 && viewport.height.0 > 0,
+            "grain viewport must be positive"
+        );
+        if let Some(grain) = self.grain.as_mut().filter(|g| g.version == config.version) {
+            // A viewport resize changes the ambient raster, not its shader or
+            // repeating grain. Retain the compiled pipeline and noise texture.
+            if grain.backdrop_version != backdrop_version {
+                grain.backdrop = backdrop
+                    .as_ref()
+                    .map(|b| {
+                        upload_rgba_texture(
+                            &self.device,
+                            &b.pixels,
+                            b.width,
+                            b.height,
+                            self.is_apple_gpu,
+                        )
+                    })
+                    .transpose()?;
+                grain.backdrop_version = backdrop_version;
+            }
+            if grain.scene.width() != viewport.width.0 as usize
+                || grain.scene.height() != viewport.height.0 as usize
+            {
+                grain.scene = grain_scene_texture(&self.device, viewport)?;
+            }
+            return Ok(Some(grain.scene.clone()));
+        }
+        let pipeline = if let Some(grain) = &self.grain {
+            // Grain pixels/opacity and ambient dimensions do not alter MSL.
+            grain.pipeline.clone()
+        } else {
+            #[cfg(feature = "runtime_shaders")]
+            let library = self
+                .device
+                .newLibraryWithSource_options_error(
+                    &NSString::from_str(SHADERS_SOURCE_FILE),
+                    Some(&objc2_metal::MTLCompileOptions::new()),
+                )
+                .context("building grain shader library")?;
+            #[cfg(not(feature = "runtime_shaders"))]
+            let library = self
+                .device
+                .newLibraryWithData_error(&dispatch2::DispatchData::from_static_bytes(
+                    SHADERS_METALLIB,
+                ))
+                .context("loading grain shader library")?;
+            let vertex = library
+                .newFunctionWithName(&NSString::from_str("grain_vertex"))
+                .context("grain vertex shader")?;
+            let fragment = library
+                .newFunctionWithName(&NSString::from_str("grain_fragment"))
+                .context("grain fragment shader")?;
+            let descriptor = MTLRenderPipelineDescriptor::new();
+            descriptor.setLabel(Some(&NSString::from_str("scene grain overlay")));
+            descriptor.setVertexFunction(Some(vertex.as_ref()));
+            descriptor.setFragmentFunction(Some(fragment.as_ref()));
+            // SAFETY: Attachment zero exists on every Metal render pipeline descriptor.
+            let attachment = unsafe { descriptor.colorAttachments().objectAtIndexedSubscript(0) };
+            attachment.setPixelFormat(MTLPixelFormat::BGRA8Unorm);
+            // The shader implements CSS compositing itself; a second fixed-function
+            // source-over blend would apply the alpha twice.
+            attachment.setBlendingEnabled(false);
+            self.device
+                .newRenderPipelineStateWithDescriptor_error(&descriptor)
+                .context("creating grain pipeline")?
+        };
+        let tile_descriptor = MTLTextureDescriptor::new();
+        // SAFETY: The public setter checked non-zero dimensions and byte length.
+        unsafe {
+            tile_descriptor.setWidth(config.width as usize);
+            tile_descriptor.setHeight(config.height as usize);
+        }
+        tile_descriptor.setPixelFormat(MTLPixelFormat::RGBA8Unorm);
+        tile_descriptor.setStorageMode(if cfg!(target_os = "ios") || self.is_apple_gpu {
+            MTLStorageMode::Shared
+        } else {
+            MTLStorageMode::Managed
+        });
+        tile_descriptor.setUsage(MTLTextureUsage::ShaderRead);
+        let tile = self
+            .device
+            .newTextureWithDescriptor(&tile_descriptor)
+            .context("allocating grain tile")?;
+        // SAFETY: Setter validation guarantees this CPU-accessible texture region
+        // is covered by the immutable, live source bytes. Upload copies them now.
+        unsafe {
+            tile.replaceRegion_mipmapLevel_withBytes_bytesPerRow(
+                MTLRegion {
+                    origin: MTLOrigin { x: 0, y: 0, z: 0 },
+                    size: MTLSize {
+                        width: config.width as usize,
+                        height: config.height as usize,
+                        depth: 1,
+                    },
+                },
+                0,
+                ptr::NonNull::from(config.pixels.as_ref()).cast(),
+                config.width as usize * 4,
+            );
+        }
+        let backdrop_texture = backdrop
+            .as_ref()
+            .map(|b| {
+                upload_rgba_texture(
+                    &self.device,
+                    &b.pixels,
+                    b.width,
+                    b.height,
+                    self.is_apple_gpu,
+                )
+            })
+            .transpose()?;
+        let scene = grain_scene_texture(&self.device, viewport)?;
+        self.grain = Some(GrainResources {
+            version: config.version,
+            opacity: config.opacity,
+            backdrop_version,
+            backdrop: backdrop_texture,
+            scene: scene.clone(),
+            tile,
+            pipeline,
+        });
+        Ok(Some(scene))
+    }
+
+    fn encode_grain(
+        &self,
+        buffer: &ProtocolObject<dyn MTLCommandBuffer>,
+        destination: &ProtocolObject<dyn MTLTexture>,
+        viewport: Size<DevicePixels>,
+    ) -> Result<()> {
+        let grain = self.grain.as_ref().context("grain resources missing")?;
+        let encoder = new_command_encoder_for_texture(buffer, destination, viewport, None)?;
+        encoder.setRenderPipelineState(&grain.pipeline);
+        // SAFETY: Texture slots, opacity and presence flag match grain_fragment.
+        // The encoder retains textures; Metal copies the live uniform bytes.
+        unsafe {
+            encoder.setFragmentTexture_atIndex(Some(&grain.scene), 0);
+            encoder.setFragmentTexture_atIndex(Some(&grain.tile), 1);
+            encoder.setFragmentTexture_atIndex(
+                Some(grain.backdrop.as_deref().unwrap_or(&grain.tile)),
+                2,
+            );
+            let has_backdrop = u32::from(grain.backdrop.is_some());
+            encoder.setFragmentBytes_length_atIndex(
+                ptr::NonNull::from(&has_backdrop).cast(),
+                mem::size_of::<u32>(),
+                1,
+            );
+            encoder.setFragmentBytes_length_atIndex(
+                ptr::NonNull::from(&grain.opacity).cast(),
+                mem::size_of::<f32>(),
+                0,
+            );
+            encoder.drawPrimitives_vertexStart_vertexCount(MTLPrimitiveType::Triangle, 0, 3);
+        }
+        encoder.endEncoding();
+        Ok(())
+    }
+}
+
+fn grain_scene_texture(
+    device: &ProtocolObject<dyn MTLDevice>,
+    viewport: Size<DevicePixels>,
+) -> Result<Retained<ProtocolObject<dyn MTLTexture>>> {
+    let descriptor = MTLTextureDescriptor::new();
+    // SAFETY: Caller checked positive viewport dimensions.
+    unsafe {
+        descriptor.setWidth(viewport.width.0 as usize);
+        descriptor.setHeight(viewport.height.0 as usize);
+    }
+    descriptor.setPixelFormat(MTLPixelFormat::BGRA8Unorm);
+    descriptor.setStorageMode(MTLStorageMode::Private);
+    descriptor.setUsage(MTLTextureUsage::RenderTarget | MTLTextureUsage::ShaderRead);
+    device
+        .newTextureWithDescriptor(&descriptor)
+        .context("allocating grain scene target")
+}
+
+fn upload_rgba_texture(
+    device: &ProtocolObject<dyn MTLDevice>,
+    pixels: &[u8],
+    width: u32,
+    height: u32,
+    apple_gpu: bool,
+) -> Result<Retained<ProtocolObject<dyn MTLTexture>>> {
+    let descriptor = MTLTextureDescriptor::new();
+    unsafe {
+        descriptor.setWidth(width as usize);
+        descriptor.setHeight(height as usize);
+    }
+    descriptor.setPixelFormat(MTLPixelFormat::RGBA8Unorm);
+    descriptor.setStorageMode(if cfg!(target_os = "ios") || apple_gpu {
+        MTLStorageMode::Shared
+    } else {
+        MTLStorageMode::Managed
+    });
+    descriptor.setUsage(MTLTextureUsage::ShaderRead);
+    let texture = device
+        .newTextureWithDescriptor(&descriptor)
+        .context("allocating scene backdrop")?;
+    // Validated immutable RGBA bytes cover the complete uploaded device texture.
+    unsafe {
+        texture.replaceRegion_mipmapLevel_withBytes_bytesPerRow(
+            MTLRegion {
+                origin: MTLOrigin { x: 0, y: 0, z: 0 },
+                size: MTLSize {
+                    width: width as usize,
+                    height: height as usize,
+                    depth: 1,
+                },
+            },
+            0,
+            ptr::NonNull::from(pixels).cast(),
+            width as usize * 4,
+        );
+    }
+    Ok(texture)
+}
diff --git a/src/shaders.metal b/src/shaders.metal
index 2b52bb9..837e3f3 100644
--- a/src/shaders.metal
+++ b/src/shaders.metal
@@ -1277,3 +1277,39 @@ float4 fill_color(Background background,
 
   return color;
 }
+
+// Optional process-local scene postprocess. Neither scene pixels nor noise
+// are resampled: input.position addresses their exact device-pixel centres.
+struct GrainVertexOutput { float4 position [[position]]; };
+vertex GrainVertexOutput grain_vertex(uint id [[vertex_id]]) {
+  const float2 vertices[3] = {float2(-1.0,-1.0),float2(3.0,-1.0),float2(-1.0,3.0)};
+  return {float4(vertices[id],0.0,1.0)};
+}
+fragment float4 grain_fragment(float4 position [[position]],
+    texture2d<float, access::read> scene [[texture(0)]],
+    texture2d<float, access::read> tile [[texture(1)]],
+    texture2d<float, access::read> ambient [[texture(2)]],
+    constant float &opacity [[buffer(0)]],
+    constant uint &has_backdrop [[buffer(1)]]) {
+  uint2 pixel=uint2(position.xy);
+  float4 destination=scene.read(pixel);
+  if (has_backdrop != 0) {
+    // scene is already premultiplied RGBA8; ambient upload is straight RGBA.
+    // Quantization happens in the UI target, before this source-over step.
+    float4 background=ambient.read(pixel);
+    destination=float4(destination.rgb + background.rgb*background.a*(1.0-destination.a),
+        destination.a + background.a*(1.0-destination.a));
+  }
+  float4 source=tile.read(pixel % uint2(tile.get_width(),tile.get_height()));
+  float source_alpha=source.a*opacity;
+  float3 backdrop=destination.a>0.0 ? destination.rgb/destination.a : float3(0.0);
+  float3 multiply=2.0*backdrop*source.rgb;
+  float3 screen=1.0-2.0*(1.0-backdrop)*(1.0-source.rgb);
+  float3 blend=select(multiply,screen,backdrop>0.5);
+  // W3C blend+source-over in premultiplied destination storage. The host's
+  // opaque scene reduces this to mix(backdrop,overlay,.05*noiseAlpha).
+  float3 output=(1.0-source_alpha)*destination.rgb + source_alpha*
+      ((1.0-destination.a)*source.rgb+destination.a*blend);
+  float alpha=source_alpha+destination.a*(1.0-source_alpha);
+  return float4(output,alpha);
+}
