<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Applied to child processes/frameworks Electron itself signs (helper
	     apps, the GPU/renderer/plugin helpers) — same two entitlements as the
	     main app, for the same reason: they run the same V8 under Hardened
	     Runtime. See entitlements.mac.plist for what this deliberately does
	     not include and why. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
